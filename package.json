{
  "name": "mercure",
  "version": "0.0.0",
  "private": true,
  "description": "Mercure modular security platform",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.4.2 <13"
  },
  "scripts": {
    "repo:setup": "git config core.hooksPath .githooks",
    "nx": "nx",
    "graph": "nx graph",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "build": "nx run-many -t build"
  },
  "devDependencies": {
    "@nx/js": "23.2.1",
    "@nx/workspace": "23.2.1",
    "nx": "23.2.1",
    "prettier": "3.9.0",
    "typescript": "6.0.3"
  }
}
