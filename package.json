{
  "name": "mercure",
  "version": "0.0.0",
  "private": true,
  "description": "Mercure modular security platform",
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=12.4.2 <13"
  },
  "scripts": {
    "repo:setup": "git config core.hooksPath .githooks",
    "nx": "nx",
    "graph": "nx graph",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "nx run-many -t lint",
    "typecheck": "pnpm db:generate && nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "build": "pnpm db:generate && nx run-many -t build",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "api:client:generate": "pnpm db:generate && node tools/openapi/generate-client.mjs",
    "api:client:check": "pnpm db:generate && node tools/openapi/generate-client.mjs --check",
    "ops:verify-auth": "bash scripts/ops/verify-production-auth.sh",
    "release:prepare": "pnpm release:prepare-api && node scripts/release/prepare-release-artifacts.mjs",
    "release:prepare-api": "pnpm exec nx run api:prune && node scripts/release/sync-api-build-policy.mjs"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/helmet": "13.1.1",
    "@fastify/static": "10.1.3",
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "12.0.0",
    "@nestjs/core": "11.2.5",
    "@nestjs/platform-fastify": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "fastify": "5.12.5",
    "jose": "6.2.3",
    "nestjs-pino": "5.1.0",
    "nestjs-zod": "5.5.0",
    "next": "16.3.3",
    "openapi-fetch": "0.17.0",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4",
    "tar-stream": "3.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.3",
    "@nx/esbuild": "23.2.1",
    "@nx/eslint": "23.2.1",
    "@nx/eslint-plugin": "23.2.1",
    "@nx/js": "23.2.1",
    "@nx/nest": "23.2.1",
    "@nx/next": "23.2.1",
    "@nx/workspace": "23.2.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dotenv": "17.4.2",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "nx": "23.2.1",
    "prettier": "3.9.0",
    "prisma": "7.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0",
    "webpack": "5.110.3"
  }
}
