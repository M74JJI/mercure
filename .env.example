NODE_ENV=development
SERVICE_NAME=mercure-api
API_HOST=0.0.0.0
API_PORT=3001
API_CORS_ORIGINS=http://localhost:3000
API_BODY_LIMIT_BYTES=1048576
LOG_LEVEL=info
OPENAPI_ENABLED=true
DATABASE_URL=postgresql://mercure:mercure-local@localhost:5432/mercure
DATABASE_DIRECT_URL=postgresql://mercure:mercure-local@localhost:5432/mercure
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_HEALTH_TIMEOUT_MS=2000
RULES_MANAGER_ARCHIVE_DIR=/opt/mercure/siem-managers
RULES_ARCHIVE_MAX_FILES=10000
RULES_ARCHIVE_MAX_ENTRY_BYTES=5242880
RULES_ARCHIVE_MAX_TOTAL_BYTES=268435456
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
