NODE_ENV=development
SERVICE_NAME=mercure-api
API_HOST=0.0.0.0
API_PORT=3001
API_CORS_ORIGINS=http://localhost:3000
API_BODY_LIMIT_BYTES=4194304
LOG_LEVEL=info
OPENAPI_ENABLED=false

# Backend OIDC / Keycloak. Production requires explicit HTTPS issuer, API audience,
# client-role namespace, and application-specific authority mappings. Do not rely on
# generic realm roles such as "admin" in production.
OIDC_ISSUER_URL=https://identity.example.test/realms/mercure
# OIDC_JWKS_URL=https://identity.example.test/realms/mercure/protocol/openid-connect/certs
OIDC_AUDIENCE=mercure-api
OIDC_CLIENT_ID=mercure-api
OIDC_ADMIN_AUTHORITIES=admin,/security-admins
OIDC_USER_AUTHORITIES=user,/security-users
OIDC_JWKS_TIMEOUT_MS=5000
OIDC_JWKS_COOLDOWN_MS=30000
OIDC_JWKS_CACHE_MAX_AGE_MS=600000

DATABASE_URL=postgresql://mercure:mercure-local@localhost:5432/mercure
DATABASE_DIRECT_URL=postgresql://mercure:mercure-local@localhost:5432/mercure
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_HEALTH_TIMEOUT_MS=2000
RULES_MANAGER_ARCHIVE_DIR=/opt/mercure/siem-managers
RULES_ARCHIVE_MAX_ARCHIVES=64
RULES_ARCHIVE_MAX_COMPRESSED_BYTES=536870912
RULES_ARCHIVE_MAX_DECOMPRESSED_BYTES=536870912
RULES_ARCHIVE_MAX_FILES=10000
RULES_ARCHIVE_MAX_ENTRY_BYTES=5242880
RULES_ARCHIVE_MAX_TOTAL_BYTES=268435456
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Next.js/Auth.js Keycloak configuration. Replace all secret/example values in
# production. AUTH_URL and AUTH_KEYCLOAK_ISSUER must use HTTPS in production.
# WEB_AUTH_* authority mappings are also required explicitly in production.
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_KEYCLOAK_ID=mercure-web
AUTH_KEYCLOAK_SECRET=replace-with-keycloak-client-secret
AUTH_KEYCLOAK_ISSUER=https://identity.example.test/realms/mercure
WEB_AUTH_AUTHORITY_CLIENT_ID=mercure-api
WEB_AUTH_ADMIN_AUTHORITIES=admin,/security-admins
WEB_AUTH_USER_AUTHORITIES=user,/security-users
WEB_AUTH_REFRESH_SKEW_SECONDS=60
WEB_AUTH_REFRESH_TIMEOUT_MS=5000
WEB_AUTH_SESSION_MAX_AGE_SECONDS=28800
