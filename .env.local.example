NODE_ENV=development
SERVICE_NAME=mercure-api
API_HOST=127.0.0.1
API_PORT=3001
API_CORS_ORIGINS=http://localhost:3000
API_BODY_LIMIT_BYTES=4194304
LOG_LEVEL=debug
OPENAPI_ENABLED=true

DATABASE_URL=postgresql://mercure:mercure-local@127.0.0.1:5432/mercure
DATABASE_DIRECT_URL=postgresql://mercure:mercure-local@127.0.0.1:5432/mercure
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_HEALTH_TIMEOUT_MS=2000

OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/mercure-e2e
OIDC_JWKS_URL=http://127.0.0.1:8080/realms/mercure-e2e/protocol/openid-connect/certs
OIDC_AUDIENCE=mercure-api
OIDC_CLIENT_ID=mercure-api
OIDC_ADMIN_AUTHORITIES=admin
OIDC_USER_AUTHORITIES=user
OIDC_JWKS_TIMEOUT_MS=5000
OIDC_JWKS_COOLDOWN_MS=30000
OIDC_JWKS_CACHE_MAX_AGE_MS=600000

RULES_INTELLIGENCE_RATE_LIMIT_MAX_REQUESTS=120
RULES_INTELLIGENCE_RATE_LIMIT_WINDOW_SECONDS=60
RULES_MANAGER_ARCHIVE_DIR=.local/siem-managers
RULES_ARCHIVE_MAX_ARCHIVES=64
RULES_ARCHIVE_MAX_COMPRESSED_BYTES=536870912
RULES_ARCHIVE_MAX_DECOMPRESSED_BYTES=536870912
RULES_ARCHIVE_MAX_FILES=10000
RULES_ARCHIVE_MAX_ENTRY_BYTES=5242880
RULES_ARCHIVE_MAX_TOTAL_BYTES=268435456

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001/api/v1
AUTH_SECRET=mercure-local-development-secret-change-before-sharing
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
AUTH_KEYCLOAK_ID=mercure-web-e2e
AUTH_KEYCLOAK_SECRET=mercure-web-e2e-secret
AUTH_KEYCLOAK_ISSUER=http://127.0.0.1:8080/realms/mercure-e2e
WEB_AUTH_AUTHORITY_CLIENT_ID=mercure-api
WEB_AUTH_ADMIN_AUTHORITIES=admin
WEB_AUTH_USER_AUTHORITIES=user
WEB_AUTH_REFRESH_SKEW_SECONDS=60
WEB_AUTH_REFRESH_TIMEOUT_MS=5000
WEB_AUTH_SESSION_MAX_AGE_SECONDS=28800
