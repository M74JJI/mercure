#!/usr/bin/env bash
set -euo pipefail

message_file="${1:?commit message file is required}"
subject="$(head -n 1 "$message_file")"
pattern='^(feature|fix|security|config|refactor|test|docs|build|ci|perf|chore|revert):([a-z0-9]+(-[a-z0-9]+)*):([a-z0-9]+(-[a-z0-9]+)*)$'

if [[ ! "$subject" =~ $pattern ]]; then
  echo "Commit rejected: '$subject'" >&2
  echo "Expected: <type>:<scope>:<kebab-case-description>" >&2
  exit 1
fi

if grep -Eiq '(Co-authored-by:.*(ChatGPT|Claude|Codex|OpenAI|Anthropic)|Generated-by:.*(ChatGPT|Claude|Codex|OpenAI|Anthropic)|AI-assisted:)' "$message_file"; then
  echo "Commit rejected: AI/tool attribution metadata is not allowed." >&2
  exit 1
fi
